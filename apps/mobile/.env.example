# BuenaMano mobile — copy to .env (never commit secrets)
# App boots without these; Supabase client stays null / "not configured".

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: publishable key if client lib supports it (prefer anon JWT for Expo today)
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Future (not required for P0 scaffold)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# EAS_PROJECT_ID=
# WOMPI_*  — deferred past P0
